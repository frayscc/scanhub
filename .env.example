DEBUG_ENABLED=false
# 使用 python -c "import secrets; print(secrets.token_urlsafe(32))" 分别生成两个不同令牌
UPLOAD_TOKEN=
ADMIN_TOKEN=
MAX_UPLOAD_MB=50
MAX_CONCURRENT_UPLOADS=2
DEBUG_RESPONSE_STATUS=200
DEBUG_RESPONSE_BODY={"success":true}
DEBUG_RESPONSE_CONTENT_TYPE=application/json
# 运行 python -m scanhub.security 交互生成密码哈希；不要填写明文密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# 仅在 HTTPS 反向代理部署时设为 true；HTTP 局域网须 false
COOKIE_SECURE=false
# 就绪检查所需最低剩余空间；单位 MiB
MIN_FREE_MB=64
